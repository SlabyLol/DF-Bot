# Copy this file to .env and fill in the values after creating your GitHub App

# App ID from the GitHub App settings page
APP_ID=12345

# Webhook secret you set when creating the app
WEBHOOK_SECRET=development

# Private key (paste the entire content of the .pem file)
# Or use PRIVATE_KEY_PATH=./private-key.pem
PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Optional: for local development with smee.io
# WEBHOOK_PROXY_URL=https://smee.io/your-unique-url
